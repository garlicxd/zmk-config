ZMK_COMBO(f12_combo, &kp F12, LN5 LT5, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f1_combo,  &kp F1,  LN4 LT4, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f2_combo,  &kp F2,  LN3 LT4, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f3_combo,  &kp F3,  LN2 LT3, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f4_combo,  &kp F4,  LN1 LT2, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f5_combo,  &kp F5,  LN0 LT1, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f6_combo,  &kp F6,  RN0 RT0, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f7_combo,  &kp F7,  RN1 RT1, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f8_combo,  &kp F8,  RN2 RT2, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f9_combo,  &kp F9,  RN3 RT3, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f10_combo, &kp F10, RN4 RT4, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f11_combo, &kp F11, RN5 RT5, L_DEF L_GAME, COMBO_TERM_SLOW, COMBO_IDLE_FAST)

ZMK_COMBO(pscrn_combo, &kp PSCRN,       LM5 LB5, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(caps_combo,  &kp CAPS,        LM4 LT4, L_DEF,         COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(redo_combo,  &kp LS(Y),       LB4 LM4, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(cut_combo,   &kp LC(X),       LB3 LM3, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(enter_combo, &kp ENTER,       LB2 LM2, L_DEF,         COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(tab_combo,   &kp TAB,         LB1 LM1, L_DEF,         COMBO_TERM_SLOW, COMBO_IDLE_FAST)

ZMK_COMBO(capsw_combo, &caps_word,      LM1 LT1, L_DEF,         COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(esc_combo,   &kp ESC,         LM1 LT1, L_DEF,         COMBO_TERM_SLOW, COMBO_IDLE_FAST)

ZMK_COMBO(left_combo,  &kp LEFT_ARROW,  RT0 RM0, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(down_combo,  &kp DOWN_ARROW,  RT1 RM1, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(up_combo,    &kp UP_ARROW,    RT2 RM2, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(right_combo, &kp RIGHT_ARROW, RT3 RM3, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)

ZMK_COMBO(home_combo,  &kp HOME,        RM0 RB0, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(pgdn_combo,  &kp PGDN,        RM1 RB1, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(pgup_combo,  &kp PGUP,        RM2 RB2, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(end_combo,   &kp END,         RM3 RB3, L_DEF L_GAME,  COMBO_TERM_SLOW, COMBO_IDLE_FAST)


/ {
    scroll_encoder: scroll_encoder { compatible = "zmk,behavior-sensor-rotate"; #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>; tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap { 
        compatible = "zmk,keymap";

        L_DEF { sensor-bindings = <&scroll_encoder>; display-name = "Default Layer"; bindings = < 
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮          ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp DEL       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5      &kp UP_ARROW &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp BSPC
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp GRAVE     &kp Q         &kp W         &kp E         &kp R         &kp T      &kp DOWN_ARROW &kp Y        &kp U         &kp I         &kp O         &kp P         &kp APOS
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp MINUS     &kp A         &kp S         &kp D         &kp F         &kp G      &kp LEFT_ARROW &kp H        &kp J         &kp K         &kp L         &kp SEMI      &kp LBKT
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp EQUAL     &hml Z LALT   &hml X LCTL   &hml C LGUI   &hml V LSFT   &kp B      &kp RIGHT_ARROW &kp N      &hmr M RSFT &hmr COMMA RGUI &hmr DOT RCTL &hmr FSLH RALT &kp RBKT
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
    &kp C_MUTE    &kp A         &kp A         &kp A         L_MAGIC       L_SPACEREP    &kp ENTER  R_SPACEREP    R_MAGIC       &kp A         &kp A         &kp A
//              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯          ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
            >;
        };

        L_GAME { sensor-bindings = <&scroll_encoder>; display-name = "GAME"; bindings = < 
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮          ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp DEL       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5      &kp UP_ARROW &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp BSPC
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T      &kp DOWN_ARROW &kp Y        &kp U         &kp I         &kp O         &kp P         &kp APOS
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LCTL      &kp A         &kp S         &kp D         &kp F         &kp G      &kp LEFT_ARROW &kp H        &kp J         &kp K         &kp L         &kp SEMI      &kp LBKT
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LSFT      &kp Z         &kp X         &kp C         &kp V         &kp B      &kp RIGHT_ARROW &kp N       &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp RBKT
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
    &kp C_MUTE    &trans        &kp ESC       &kp LGUI      &kp LALT      &kp SPACE    &kp ENTER   &kp SPACE     &kp RALT      &kp RGUI      &kp RSFT      &mo L_MOU
//              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯          ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
            >;
        };

        L_MOU {
            bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮        ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &mkp MCLK     &mkp LCLK     &mkp RCLK     &mkp MB4      &mkp MB5      &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans     &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯        ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
            >;

            display-name = "Mouse Layer";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        L_OPT { sensor-bindings = <&scroll_encoder>; display-name = "OPTIONS"; bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮        ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &tog L_GAME   &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &sys_reset    &trans   &sys_reset    &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans       &bt BT_CLR_ALL &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &bootloader   &trans   &bootloader   &trans        &trans        &trans        &trans        &trans
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯        ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        >;};


    };
};