#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define ZMK_HELPER_KEEP_NATIVE 0
#include "zmk-helpers/helper.h"

#include "eyelash_sofle_keydefs.dtsi" // Extra key definitions following urob's setup

#define L_DEF 0
#define L_MOU 1
#define L_OPT 2

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

#define QUICK_TAP_MS 175
&sk {
    release-after-ms = <900>;
    quick-release;
};
&sl { // Allow sticky mods to chord across sticky layers.
    ignore-modifiers;
};
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    hold-trigger-key-positions = <0>;
};
&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};
&key_repeat {
    usage-pages = <HID_USAGE_KEY HID_USAGE_CONSUMER>;
};

&soft_off { hold-time-ms = <2000>; };

// Hardcoded, on updating the keymap, the sides have to be adjusted accordingly
#define LEFT_CHARS B Y O U Q C I E A Z
#define LEFT_SYMBS SLASH BACKSLASH MINUS UNDERSCORE COMMA ASTERISK DOT DOUBLE_QUOTES CARET DOLLAR AMPERSAND SEMICOLON HASH AT_SIGN QUESTION PIPE EXCLAMATION PERCENT EQUAL ESCAPE
#define RIGHT_CHARS J L D W V K H T N S X M G P F
#define RIGHT_SYMBS TILDE COLON LEFT_BRACKET LESS_THAN SINGLE_QUOTE GRAVE PLUS LEFT_PARENTHESIS LEFT_BRACE RIGHT_BRACKET GREATER_THAN RIGHT_PARENTHESIS RIGHT_BRACE
#define NUM_CHARS N0 N1 N2 N3 N4 N5 N6 N7 N8 N9
#define ADAPTIVE_RESET 1200
#define COMBO_TERM_FAST 30
#define COMBO_TERM_SLOW 250
#define COMBO_IDLE_FAST 30
#define COMBO_IDLE_SLOW 150
#define SHIFT_MORPH(NAME, BINDING1, BINDING2) \
    ZMK_MOD_MORPH(NAME, bindings = <BINDING1>, <BINDING2>; mods = <(MOD_LSFT|MOD_RSFT)>;)

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                  \
    ZMK_HOLD_TAP( NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";          \
                    tapping-term-ms = <200>; quick-tap-ms = <QUICK_TAP_MS>;     \
                    require-prior-idle-ms = <150>;                              \
                    hold-trigger-key-positions = <TRIGGER_POS>;                 \
                    hold-trigger-on-release;                                    \
                )
MAKE_HRM(hmt, &mo, &kp, KEYS_R KEYS_L KEYS_T) // Tap mod, hold key

#define RUNE_L &hm_rune_l LSHIFT 0
    ZMK_MOD_MORPH(rune_l, bindings = <&sk LSHIFT>, <&arc_left>; mods = <(MOD_LSFT|MOD_RSFT)>;)
    MAKE_HRM(hm_rune_l, &kp, &rune_l, KEYS_R KEYS_L KEYS_T_R) // Tap mod, hold runic left
    ZMK_ADAPTIVE_KEY(arc_left, bindings = <&key_repeat>;
        spc_sft {bindings = <&sk LSHIFT>; trigger-keys = <SPACE>; max-prior-idle-ms = <ADAPTIVE_RESET>;};
    )

#define RUNE_R &hm_rune_r RSHIFT 0
    ZMK_MOD_MORPH(rune_r, bindings = <&sk RSHIFT>, <&arc_right>; mods = <(MOD_LSFT|MOD_RSFT)>;)
    MAKE_HRM(hm_rune_r, &kp, &rune_r, KEYS_L KEYS_R KEYS_T_L) // Tap mod, hold runic right
    ZMK_ADAPTIVE_KEY(arc_right, bindings = <&key_repeat>;
        spc_sft {bindings = <&sk RSHIFT>; trigger-keys = <SPACE>; max-prior-idle-ms = <ADAPTIVE_RESET>;};
    )

#define STICKY_L &sticky_l LSHIFT LSHIFT
    MAKE_HRM(sticky_l, &sk, &kp, KEYS_R KEYS_T_R)

#define STICKY_R &sticky_r RSHIFT RSHIFT
    MAKE_HRM(sticky_r, &sk, &kp, KEYS_L KEYS_T_L)

// function combos
ZMK_COMBO(f1_combo,  &kp F1,  LN5 LT5, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f2_combo,  &kp F2,  LN4 LT4, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f3_combo,  &kp F3,  LN3 LT3, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f4_combo,  &kp F4,  LN2 LT2, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f5_combo,  &kp F5,  LN1 LT1, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f6_combo,  &kp F6,  LN0 LT0, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f7_combo,  &kp F7,  RN0 RT0, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f8_combo,  &kp F8,  RN1 RT1, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f9_combo,  &kp F9,  RN2 RT2, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f10_combo, &kp F10, RN3 RT3, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f11_combo, &kp F11, RN4 RT4, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(f12_combo, &kp F12, RN5 RT5, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)

ZMK_COMBO(lbkt_combo,   &kp LBKT,  LT3 LM3, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt_combo,   &kp RBKT,  LT2 LM2, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(apos_combo,   &kp APOS,  LT1 LM1, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(grave_combo,  &kp GRAVE, LM3 LB3, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(bslh_combo,   &kp BSLH,  LM2 LB2, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)

ZMK_COMBO(left_combo,  &kp LEFT_ARROW,  RT1 RM1, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(down_combo,  &kp DOWN_ARROW,  RT2 RM2, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(up_combo,    &kp UP_ARROW,    RT3 RM3, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(right_combo, &kp RIGHT_ARROW, RT4 RM4, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)

ZMK_COMBO(home_combo,  &kp HOME,        RM1 RB1, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(pgdn_combo,  &kp PGDN,        RM2 RB2, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(pgup_combo,  &kp PGUP,        RM3 RB3, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)
ZMK_COMBO(end_combo,   &kp END,         RM4 RB4, L_DEF, COMBO_TERM_SLOW, COMBO_IDLE_FAST)

/ {
    scroll_encoder: scroll_encoder { compatible = "zmk,behavior-sensor-rotate"; #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>; tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        L_DEF { sensor-bindings = <&scroll_encoder>; display-name = "Default Layer"; bindings = < 
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮          ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6      &kp UP_ARROW &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS     &kp EQUAL
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp DEL       &kp TAB       &kp Q         &kp W         &kp E         &kp R      &kp DOWN_ARROW &kp T        &kp Y         &kp U         &kp I         &kp O         &kp P
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp BSPC      &kp LCTRL     &kp A         &kp S         &kp D         &kp F      &kp LEFT_ARROW &kp G        &kp H         &kp J         &kp K         &kp L         &kp SEMI
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp ENTER     &kp ESC       &kp Z         &kp X         &kp C         &kp V      &kp RIGHT_ARROW &kp B       &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤          ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
    &kp C_MUTE    &mo L_OPT     &kp LGUI      &kp LALT      &kp LSHIFT    &kp SPACE    &kp ENTER   &kp SPACE     &kp RSHIFT    &kp RALT      &kp RSHFT     &mo L_MOU
//              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯          ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
            >;
        };

        L_MOU {
            bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮        ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &mkp MCLK     &mkp LCLK     &mkp RCLK     &mkp MB4      &mkp MB5      &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans
//              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯        ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
            >;

            display-name = "Mouse Layer";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

//         L_MOU {
//             bindings = <
// &kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &trans
// &trans      &kp GRAVE        &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4           &mmv MOVE_DOWN   &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
// &trans      &kp TILDE        &trans          &trans           &trans           &mkp MB5           &mmv MOVE_LEFT   &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
// &trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
// &kp C_MUTE  &trans           &trans          &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &trans     &trans
//             >;

//             display-name = "layer1";
//             sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
//         };

        L_OPT { sensor-bindings = <&scroll_encoder>; display-name = "OPTIONS"; bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮        ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &sys_reset    &trans   &sys_reset    &trans        &trans        &trans        &trans        &trans
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans       &bt BT_CLR_ALL &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &bootloader   &trans   &bootloader   &trans        &trans        &trans        &trans        &trans
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤        ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────╯
    &trans        &trans        &trans        &trans        &trans        &trans        &trans   &trans        &trans        &trans        &trans        &trans
//              ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯        ╰─────────────┴─────────────┴─────────────┴─────────────┴─────────────╯
        >;};
    };
};
